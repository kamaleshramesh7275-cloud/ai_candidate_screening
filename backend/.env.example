# Backend environment variables
# Copy this file to .env and fill in real values (never commit .env!)

# PostgreSQL connection string
# For local dev, spin up Postgres with: docker compose up -d
# Then use: postgresql://postgres:password@localhost:5432/ai_recruiter
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_recruiter"

PORT=3001
JWT_SECRET=supersecretrecruiterjwttokenkey
RECRUITER_PASSWORD=admin
